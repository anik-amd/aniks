---
import Base from '../layouts/Base.astro';
import { PERSON, QUOTE, SAME_AS, SECTIONS, SITE } from '../consts';
import { LINK_ICONS } from '../link-icons';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: PERSON.name,
  alternateName: PERSON.alternateName,
  url: `${SITE.url}/`,
  image: `${SITE.url}${SITE.ogImage}`,
  jobTitle: PERSON.jobTitle,
  email: `mailto:${PERSON.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: PERSON.city,
    addressCountry: 'BD',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Bangladesh University of Engineering and Technology',
    alternateName: 'BUET',
  },
  knowsAbout: [
    'Data science',
    'Machine learning',
    'Open-source software',
    'Decentralized systems',
    'Cybersecurity',
  ],
  sameAs: SAME_AS,
};
---

<Base>
  <Fragment slot="masthead">
    <h1 class="name">{PERSON.name}</h1>
    <p class="lead">Hello World. 👋<!-- taste-skill-ignore: the author's own greeting --></p>
  </Fragment>

  <div class="intro">
    <p>
      <span class="initial">I</span>'m {PERSON.name}. Based in{' '}
      <svg
        class="pin"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 21s-6.5-5.4-6.5-10a6.5 6.5 0 1 1 13 0c0 4.6-6.5 10-6.5 10Z" />
        <circle cx="12" cy="11" r="2.4" />
      </svg>{PERSON.city}, {PERSON.country}.
    </p>
    <p>
      Currently doing my MSc in Data Science at <a href={PERSON.universityUrl}>{PERSON.university}</a>,
      figuring out how to make machines actually useful instead of just profitable.
    </p>
    <p>
      I care about open-source tech, decentralized systems, and the occasional deep dive into
      cybersecurity. I read too much, watch too many weird movies, and keep a diary I'll probably
      never finish.
    </p>
  </div>

  {
    SECTIONS.map((section) => (
      <section class="section" aria-labelledby={`${section.id}-title`}>
        <h2 class="section-title" id={`${section.id}-title`}>
          <svg
            class="section-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            set:html={section.icon}
          />
          <span>{section.title}</span>
        </h2>
        <p class="section-lede">{section.lede}</p>
        <ul class="links">
          {section.links.map((link) => (
            <li>
              <a href={link.href} rel="me">
                <svg
                  class="link-icon"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={LINK_ICONS[link.icon]} />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <figure class="quote">
    <blockquote class="quote-text">
      <p>{QUOTE.text}</p>
    </blockquote>
    <figcaption class="quote-author">{QUOTE.author}</figcaption>
  </figure>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Base>
