---
import Base from '../layouts/Base.astro';
import { FEATURED, PERSON, QUOTE, SAME_AS, SECTIONS, SITE } from '../consts';
import { ACTIVITY } from '../data/activity';
import { LINK_ICONS } from '../link-icons';

const nameChars = [...PERSON.name];

// The weekly snapshot. Build-time only: the page never asks for this itself.
const { music, books } = ACTIVITY;
const hasNow = Boolean(music) || books.length > 0;

// Absolute, never relative: a build-time "2 hours ago" would freeze into a lie.
const playedLabel = music?.playedAt
  ? new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Asia/Dhaka',
    }).format(new Date(music.playedAt))
  : null;

const trackLabel = music ? [music.track, music.artist].filter(Boolean).join(' by ') : '';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: PERSON.name,
  alternateName: PERSON.alternateName,
  url: `${SITE.url}/`,
  image: `${SITE.url}${SITE.ogImage}`,
  jobTitle: PERSON.jobTitle,
  email: `mailto:${PERSON.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: PERSON.city,
    addressCountry: 'BD',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Bangladesh University of Engineering and Technology',
    alternateName: 'BUET',
  },
  knowsAbout: [
    'Data science',
    'Machine learning',
    'Open-source software',
    'Decentralized systems',
    'Cybersecurity',
  ],
  sameAs: SAME_AS,
};
---

<Base type="profile">
  <Fragment slot="masthead">
    <h1 class="name" aria-label={PERSON.name}>
      <span class="name-text" aria-hidden="true">
        {
          nameChars.map((char, index) =>
            char === ' ' ? (
              ' '
            ) : (
              <span class="letter" style={`--i:${index}`}>
                {char}
              </span>
            ),
          )
        }
      </span>
    </h1>
    <p class="lead">Hello World. 👋<!-- taste-skill-ignore: the author's own greeting --></p>
  </Fragment>

  <div class="intro">
    <p>
      <span class="initial">I</span> am {PERSON.name}. Based in{' '}
      <svg
        class="pin"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 21s-6.5-5.4-6.5-10a6.5 6.5 0 1 1 13 0c0 4.6-6.5 10-6.5 10Z" />
        <circle cx="12" cy="11" r="2.4" />
      </svg><a class="place" href={PERSON.cityUrl} target="_blank" rel="noopener noreferrer">{PERSON.city}, {PERSON.country}</a>.
    </p>
    <p>
      Currently doing my MSc in Data Science at{' '}
      <a href={PERSON.universityUrl} target="_blank" rel="noopener noreferrer">{PERSON.university}</a>,
      figuring out how to make machines actually useful instead of just profitable.
    </p>
    <p>
      I care about open-source tech, decentralized systems, and the occasional deep dive into
      cybersecurity. I read too much, watch too many weird movies, and keep a diary I'll probably
      never finish.
    </p>
  </div>

  {
    hasNow && (
      <section class="section now" aria-label="Now">
        {music && (
          <div class="now-music">
            <!--now:music-->
            <a
              class="now-player"
              href={music.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${trackLabel}, on Last.fm`}
            >
              {music.art ? (
                <img
                  class="now-art"
                  src={music.art}
                  alt=""
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="now-art now-art-empty" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    focusable="false"
                  >
                    <path d="M9 17.5V6l10-2v11.5" />
                    <circle cx="6.5" cy="17.5" r="2.5" />
                    <circle cx="16.5" cy="15.5" r="2.5" />
                  </svg>
                </span>
              )}
              <span class="now-copy">
                <span class="now-track">{music.track}</span>
                {music.artist && <span class="now-artist">{music.artist}</span>}
                <span class="now-state">
                  {music.nowPlaying ? (
                    'Now playing'
                  ) : playedLabel ? (
                    <>
                      Last played <time datetime={music.playedAt}>{playedLabel}</time>
                    </>
                  ) : (
                    'Last played'
                  )}
                </span>
              </span>
              <span class:list={['now-bars', { 'is-playing': music.nowPlaying }]} aria-hidden="true">
                <i></i>
                <i></i>
                <i></i>
                <i></i>
              </span>
            </a>
            <!--/now:music-->
          </div>
        )}
        {books.length > 0 && (
          <ul class="now-shelf" aria-label="Currently reading">
            {books.map((book) => (
              <li>
                <a
                  href={book.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${book.title}${book.author ? ` by ${book.author}` : ''}, on Goodreads`}
                >
                  {book.cover ? (
                    <img
                      class="now-cover"
                      src={book.cover}
                      alt=""
                      width="80"
                      height="120"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="now-cover now-cover-empty">{book.title}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  <section class="section featured" aria-labelledby="featured-title">
    <h2 class="section-title" id="featured-title">
      <svg
        class="section-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        set:html={'<path d="M6 3h12v18l-6-4.6L6 21Z" />'}
      />
      <span>Featured</span>
    </h2>
    <p class="section-lede">Works that I'm proud of.</p>
    <ul class="cards">
      {FEATURED.map((item) => (
        <li class="card">
          <a class="card-link" href={item.href} target="_blank" rel="noopener noreferrer">
            <span class="card-head">
              <span class="card-tag">#{item.tag}</span>
              <svg
                class="card-arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M7 17 17 7" />
                <path d="M9 7h8v8" />
              </svg>
            </span>
            <span class="card-title">{item.title}</span>
            <span class="card-note">{item.note}</span>
            <span class="card-meta">{item.meta}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {
    SECTIONS.map((section) => (
      <section class="section" aria-labelledby={`${section.id}-title`}>
        <h2 class="section-title" id={`${section.id}-title`}>
          <svg
            class="section-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
            set:html={section.icon}
          />
          <span>{section.title}</span>
        </h2>
        <p class="section-lede">{section.lede}</p>
        <ul class="links">
          {section.links.map((link) => {
            const external = link.href.startsWith('http');
            // Mastodon verifies the profile through an exact rel="me" link.
            const rel = link.icon === 'mastodon' ? 'me' : external ? 'me noopener noreferrer' : 'me';
            return (
              <li>
                <a href={link.href} rel={rel} target={external ? '_blank' : undefined}>
                  <svg
                    class="link-icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d={LINK_ICONS[link.icon]} />
                  </svg>
                  <span class="link-label">{link.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }

  <figure class="quote">
    <blockquote class="quote-text">
      <p>{QUOTE.text}</p>
    </blockquote>
    <figcaption class="quote-author">{QUOTE.author}</figcaption>
  </figure>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Base>
