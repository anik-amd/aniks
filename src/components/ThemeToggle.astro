---
const options = [
  {
    value: 'system',
    label: 'System theme',
    // Monitor: follow the operating system.
    icon: '<rect x="3" y="4" width="18" height="13" rx="2" /><path d="M9 21h6M12 17v4" />',
  },
  {
    value: 'light',
    label: 'Light theme',
    // Sun.
    icon: '<circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.2 5.2l1.7 1.7M17.1 17.1l1.7 1.7M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7" />',
  },
  {
    value: 'dark',
    label: 'Dark theme',
    // Crescent.
    icon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />',
  },
] as const;
---

<div class="theme" role="group" aria-label="Colour theme">
  {
    options.map((option) => (
      <button
        type="button"
        data-theme-set={option.value}
        aria-label={option.label}
        title={option.label}
        aria-pressed={option.value === 'system' ? 'true' : 'false'}
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
          set:html={option.icon}
        />
      </button>
    ))
  }
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const buttons = Array.from(document.querySelectorAll('[data-theme-set]'));
    const key = 'theme';

    const stored = (() => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    })();

    const current = stored === 'light' || stored === 'dark' ? stored : 'system';

    const apply = (value) => {
      if (value === 'system') {
        delete root.dataset.theme;
      } else {
        root.dataset.theme = value;
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.themeSet === value));
      }
    };

    apply(current);

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const value = button.dataset.themeSet;
        try {
          localStorage.setItem(key, value);
        } catch {
          /* ignore, the choice just will not persist */
        }
        apply(value);
      });
    }
  })();
</script>
