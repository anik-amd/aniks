---
const sun =
  '<circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.2 5.2l1.7 1.7M17.1 17.1l1.7 1.7M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7" />';
const moon = '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />';
// Half-filled circle: light on one side, dark on the other.
const auto =
  '<circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" />';
---

<button
  type="button"
  class="theme-toggle"
  data-theme-cycle
  data-theme-state="system"
  aria-label="Theme: system. Change to light."
  title="Theme: system. Change to light."
>
  <svg
    class="icon icon-system"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    set:html={auto}
  />
  <svg
    class="icon icon-light"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    set:html={sun}
  />
  <svg
    class="icon icon-dark"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    set:html={moon}
  />
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('[data-theme-cycle]');
    if (!button) return;

    const key = 'theme';
    const order = ['system', 'light', 'dark'];

    const stored = (() => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    })();

    let current = stored === 'light' || stored === 'dark' ? stored : 'system';

    const apply = (value) => {
      if (value === 'system') {
        delete root.dataset.theme;
      } else {
        root.dataset.theme = value;
      }
      button.dataset.themeState = value;
      const next = order[(order.indexOf(value) + 1) % order.length];
      const label = `Theme: ${value}. Change to ${next}.`;
      button.setAttribute('aria-label', label);
      button.title = label;
    };

    apply(current);

    button.addEventListener('click', () => {
      current = order[(order.indexOf(current) + 1) % order.length];
      try {
        localStorage.setItem(key, current);
      } catch {
        /* ignore, the choice just will not persist */
      }
      apply(current);
    });
  })();
</script>
